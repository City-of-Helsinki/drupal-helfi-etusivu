<article>
  <div class="components components--computed components--helsinki-near-you-results">
    {# {% embed "@hdbt/misc/component.twig" with
      {
        component_classes: [
          'component--back-to-edit-link',
        ],
      }
    %}
      {% block component_content %}
        {% include '@hdbt/navigation/link-button.html.twig' with {
          type: 'supplementary',
          label: back_link_label,
          url: back_link_url,
          link_options: {'class': ['back-to-edit-link']},
        } %}
      {% endblock component_content %}
    {% endembed %} #}

    {# Table of contents #}
    {% embed "@hdbt/field/field--toc-enabled.html.twig" with {
      modifier_class: ['table-of-contents--helsinki-near-you-results'],
    }%}{% endembed %}

    {# News Section #}
    {% if nearby_neighbourhoods is not empty %}
      {% set neighbourhood_names = nearby_neighbourhoods | map(n => n.title.value) | join(', ', ' and ' | t({}, {'context': 'News close to you block'})) %}
      {% embed "@hdbt/misc/component.twig" with
        {
          component_classes: [
          'component--react-search',
          'component--news-archive',
          'component--coordinates-based-list',
          'component--hardcoded',
        ],
          component_title: 'News'|t({}, {'context': 'News close to you block'}),
          component_description: 'See news related to the neighbourhoods of %neighbourhoods%'|t({'%neighbourhoods%': neighbourhood_names}, {'context': 'News close to you block'}),
          component_content_class: 'news-archive',
        }
      %}
        {% block component_content %}
          {{ attach_library('hdbt/news-archive') }}
          <div
            id="helfi-etusivu-news-search"
            data-paragraph-id="helfi-coordinates-based-news-list"
          >
          </div>
          {# Indicate JS not enabled #}
          <noscript>
            <div class="news-archive__javascript-disabled">
              {{ 'You must enable JavaScript in your browser for news list to work'|t }}
            </div>
          </noscript>
          <div class="see-all-button see-all-button--near-results">
            {% set news_archive_title = 'See all news near you'|t({}, {'context': 'News close to you block'}) %}
            {% include '@hdbt/navigation/link-button.html.twig' with {
              type: 'primary',
              label: news_archive_title,
              url: news_archive_url,
            } %}
          </div>
        {% endblock component_content %}
      {% endembed %}
    {% endif %}

    {# Events Section #}
    {% embed "@hdbt/misc/component.twig" with
      {
        component_classes: [
        'component--react-search',
        'component--event-list',
        'component--coordinates-based-list',
          'component--hardcoded',
        ],
        component_title: 'Events'|trans({}, {'context': 'Helsinki near you'}),
        component_description: 'Browse events near you by date.'|trans({}, {'context': 'Helsinki near you'}),
        component_content_class: 'event-list',
      }
    %}
      {% block component_content %}
        {{ events_section }}

        <div class="see-all-button see-all-button--near-results">
          {% include '@hdbt/navigation/link-button.html.twig' with {
            type: 'primary',
            label: 'See all events near you'|t({}, {'context': 'Helsinki near you events search'}),
            url: events_archive_url,
          } %}
        </div>
      {% endblock component_content %}
    {% endembed %}

    {# Services Section #}
    {% embed "@hdbt/misc/component.twig" with
      {
        component_classes: [
          'component--popular-services',
          'component--hardcoded',
        ],
        component_title: 'Services'|t({}, {'context': 'Services near you block'}),
        component_description: 'Go from the links to the search results for your address.'|t({}, {'context': 'Services near you block'}),
        component_content_class: 'popular-services',
      }
    %}
      {% block component_content %}
        {% for service_group in service_groups %}
          {% embed "@hdbt/misc/popular-service-item.twig" with { title: service_group.title } %}
            {% block links %}
              {% embed "@hdbt/misc/popular-service-links.twig" with { items: service_group.service_links } %}
                {% block link %}
                  {% set link_attributes = {
                    'class': [
                      'link__style--highlight',
                    ],
                  } %}
                  {{ link(item.link_label, item.link_url, link_attributes) }}
                {% endblock %}
              {% endembed %}
            {% endblock links %}
          {% endembed %}
        {% endfor %}
      {% endblock component_content %}
    {% endembed %}

    {# Resident parking zone Section #}
    {% embed "@hdbt/misc/component.twig" with
      {
        component_classes: [
          'component--resident-parking-zone',
          'component--hardcoded',
        ],
        component_title: 'Your resident parking zone'|t({}, {'context': 'Helsinki near you'}),
        component_description: parking_zone
          ? 'Your resident parking zone is @zone.'|t({'@zone': parking_zone.name}, {'context': 'Helsinki near you'})
          : 'Your area has no resident parking.'|t({}, {'context': 'Helsinki near you'}),
        component_content_class: 'map',
      }
    %}
      {% block component_content %}
        {% if parking_zone %}
          {% set map_title = 'Resident parking zone map'|t({}, {'context': 'Helsinki near you'}) %}
          {% include '@hdbt/misc/embedded-content-cookie-compliance.twig' with {
            media_url: parking_zone.embedUrl,
            media_id: 'resident-parking-zone',
            media_iframe_title: map_title,
            media_service_url: 'palvelukartta.hel.fi',
            cookie_consent_groups: ['bypass'],
          } %}

          {# drupalSettings + library for the embedded-content JS that injects
             the map iframe. 'bypass' loads it without a cookie-consent gate. #}
          {{ {
            '#attached': {
              'drupalSettings': {
                'embedded_media_attributes': {
                  'resident-parking-zone': {
                    'src': parking_zone.embedUrl,
                    'title': map_title,
                    'type': 'map',
                    'skipLinkAfterId': 'resident-parking-zone-map-after',
                    'skipLinkBeforeId': 'resident-parking-zone-map-before',
                    'cookieConsentGroups': ['bypass'],
                  },
                },
              },
              'library': ['hdbt/embedded-content-cookie-compliance'],
            },
          } }}
        {% endif %}
      {% endblock component_content %}
    {% endembed %}

    {# Roadwork Section #}
    {% embed "@hdbt/misc/component.twig" with
      {
        component_classes: [
          'component--roadworks',
          'component--coordinates-based-list',
          'component--hardcoded',
        ],
        component_title: 'Street and park projects'|trans({}, {'context': 'Helsinki near you'}),
        component_description: 'Find information on street and park projects near you.'|trans({}, {'context': 'Helsinki near you'}),
        component_content_class: 'roadwork-list',
      }
    %}
      {% block component_content %}
        {{ roadwork_section }}

        <div class="see-all-button see-all-button--near-results">
          {% include '@hdbt/navigation/link-button.html.twig' with {
            type: 'primary',
            label: 'See all street and park projects near you'|t({}, {'context': 'Helsinki near you roadworks search'}),
            url: roadwork_archive_url,
          } %}
        </div>
      {% endblock component_content %}
    {% endembed %}

    {# Feedback Section #}
    {% embed "@hdbt/misc/component.twig" with
      {
        component_classes: [
          'component--feedback',
          'component--hardcoded',
        ],
        component_title: 'Feedback'|trans({}, {'context': 'Feedback close to you block'}),
        component_description: 'Find information on feedback and fault reports near you.'|trans({}, {'context': 'Feedback close to you block'}),
        component_content_class: 'feedback',
      }
    %}
      {% block component_content %}
      {{ feedback_section }}

        <div class="see-all-button see-all-button--near-results">
          {% set feedback_archive_title = 'See all feedback related to your neighbourhood'|t({}, {'context': 'Feedback close to you block'}) %}
          {% include '@hdbt/navigation/link-button.html.twig' with {
            type: 'primary',
            label: feedback_archive_title,
            url: feedback_archive_url,
          } %}
        </div>
      {% endblock component_content %}
    {% endembed %}
  </div>
</article>
