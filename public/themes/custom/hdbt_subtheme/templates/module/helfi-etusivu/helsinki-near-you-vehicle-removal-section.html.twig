{% if description %}
  <div class="component__description user-edited-content">
    {{ description }}
  </div>
{% endif %}

<div class="component__content vehicle-removal-list">
  {{ items }}
</div>

{% if button_url %}
  <div class="see-all-button see-all-button--near-results">
    {% include '@hdbt/navigation/link-button.html.twig' with {
      type: 'primary',
      label: button_label,
      url: button_url,
    } %}
  </div>
{% endif %}
