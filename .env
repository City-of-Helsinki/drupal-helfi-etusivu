#
# Enviromental values for Makefile and for docker-compose.yml
#

# Docker Compose project name
COMPOSE_PROJECT_NAME=helfi-etusivu
PROJECT_NAME=etusivu

# Azure Blob storage location of the database dump used by 'make fresh'
AZURE_DUMP_CONTAINER=hki-database-blob-helfi-etusivu-test

# Stage file proxy origin url and folder
STAGE_FILE_PROXY_ORIGIN=https://stplattaprod.blob.core.windows.net
STAGE_FILE_PROXY_ORIGIN_DIR=etusivu64e62prod

COMPOSE_PROFILES=search

# Local hostname
DRUPAL_HOSTNAME=helfi-etusivu.docker.so

# Public webroot
DRUPAL_WEBROOT=public

# Elastic url
ELASTIC_PROXY_URL=https://elastic-proxy-helfi-etusivu.docker.so
